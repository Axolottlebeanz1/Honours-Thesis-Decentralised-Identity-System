# --- Local development (Hardhat node) ---
# These are filled in by you after running `npm run deploy:local`
# (copy the printed addresses into backend/.env and frontend/.env).
DID_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=

# --- Optional: gas reporter USD conversion ---
# https://coinmarketcap.com/api/ (free tier). Without this, gas report shows ETH only.
COINMARKETCAP_API_KEY=

# Set true to print a gas-cost table when running tests: REPORT_GAS=true npm test
REPORT_GAS=false
